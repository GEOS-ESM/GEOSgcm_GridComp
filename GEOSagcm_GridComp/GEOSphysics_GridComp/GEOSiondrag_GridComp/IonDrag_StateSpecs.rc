schema_version: 2.0.0
component: IonDrag

category: INTERNAL
#--------------------------------------------------------------------------------------------------------------------
#  VARIABLE       | DIMENSION   |          Additional Metadata
#--------------------------------------------------------------------------------------------------------------------
 NAME       | UNITS   | DIMS | VLOC | UNGRIDDED | LONG NAME
#--------------------------------------------------------------------------------------------------------------------
 MLION_LATS | radians | xy   | N    |           | ml_ion_velocity_helper_latitude
 MLION_LONS | radians | xy   | N    |           | ml_ion_velocity_helper_longitude
 MLION_YY   | 1       | xy   | N    |           | ml_ion_velocity_helper_year
 MLION_DOY  | 1       | xy   | N    |           | ml_ion_velocity_helper_day_of_year
 MLION_HH   | hour    | xy   | N    |           | ml_ion_velocity_helper_hour_utc

category: IMPORT
 NAME | ALIAS | UNITS | DIMS | VLOC | RESTART | LONG NAME
 T    |       | K     | xyz  | C    | SKIP    | air_temperature
 U    |       | m s-1 | xyz  | C    | SKIP    | eastward_wind
 V    |       | m s-1 | xyz  | C    | SKIP    | northward_wind
 PLE  |       | Pa    | xyz  | E    | SKIP    | air_pressure
 ZLE  |       | m     | xyz  | E    | SKIP    | geopotential_height
 PREF |       | Pa    | z    | E    | SKIP    | reference_air_pressure

category: EXPORT
#-------------------------------------------------------------------------------------------------------
#  VARIABLE       | DIMENSIONS  |          Additional Metadata
#-------------------------------------------------------------------------------------------------------
 NAME             | ALIAS | UNITS    | DIMS | VLOC | LONG NAME
#-------------------------------------------------------------------------------------------------------
 UI_IONDRAG       |       | m s-1    | xyz  | C    | eastward_ion_velocity_from_ML
 VI_IONDRAG       |       | m s-1    | xyz  | C    | northward_ion_velocity_from_ML
 DUDT_IONDRAG     |       | m s-2    | xyz  | C    | tendency_of_eastward_wind_due_to_ion_drag
 DVDT_IONDRAG     |       | m s-2    | xyz  | C    | tendency_of_northward_wind_due_to_ion_drag
 DTDT_IONDRAG     |       | K s-1    | xyz  | C    | tendency_of_air_temperature_due_to_ion_drag_frictional_heating
 NE_IONDRAG       |       | m-3      | xyz  | C    | electron_number_density_from_IRI
 RHO_MSIS_IONDRAG |       | kg m-3   | xyz  | C    | neutral_mass_density_from_MSIS
