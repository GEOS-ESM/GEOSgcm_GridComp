# IonDrag_GridComp.rc
#
# Runtime configuration for the GEOS-MLT Ion Drag component.
# These settings override defaults in GEOS_IonDragGridComp.F90.

# Enable or disable ion drag within a GEOS-MLT run.
IONDRAG_ON:      1

# Number of model-top levels where ion drag is evaluated.
NLEV_IONDRAG:    10

# IRI altitude profile used internally before interpolation to GEOS levels [km].
IRI_HBEG:        100.0
IRI_HEND:        700.0
IRI_HSTEP:       10.0

# Temporary constant ion winds [m s-1].
# These will be replaced by ML ion-velocity output.
TEST_UI_MS:      50.0
TEST_VI_MS:      0.0
