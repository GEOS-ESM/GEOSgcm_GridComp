# IonDrag_GridComp.rc
#
# Runtime configuration for the GEOS-MLT Ion Drag component.
# These settings override defaults in GEOS_IonDragGridComp.F90.

# Enable or disable ion drag within a GEOS-MLT run.
IONDRAG_ON:  .TRUE.

# Maximum reference midpoint pressure where ion drag is evaluated [Pa].
# 0.02 Pa = 2.0e-4 hPa.
# This pressure-based lower boundary is independent of the number of model levels.
IONDRAG_BOTTOM_PRESSURE_PA: 1.0 

# IRI altitude profile used internally before interpolation to GEOS levels [km].
# The range covers the current GEOS-MLT ion-drag domain with vertical margin.
IRI_HBEG:   80.0
IRI_HEND:   250.0
IRI_HSTEP:  10.0
