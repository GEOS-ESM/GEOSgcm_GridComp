# IonDrag_GridComp.rc
#
# Runtime configuration for the GEOS-MLT Ion Drag component.
# These settings override defaults in GEOS_IonDragGridComp.F90.

# Enable or disable ion drag within a GEOS-MLT run.
IONDRAG_ON:      .TRUE.

# Maximum reference midpoint pressure where ion drag is evaluated [Pa].
# 1 Pa = 0.01 hPa. This approximately preserves the current L111
# ion-drag lower boundary while making it independent of vertical grid count.
IONDRAG_BOTTOM_PRESSURE_PA:  1

# IRI altitude profile used internally before interpolation to GEOS levels [km].
IRI_HBEG:        70.0
IRI_HEND:        300.0
IRI_HSTEP:       10.0

# Temporary constant ion winds [m s-1].
# These will be replaced by ML ion-velocity output.
TEST_UI_MS:      50.0
TEST_VI_MS:      0.0
