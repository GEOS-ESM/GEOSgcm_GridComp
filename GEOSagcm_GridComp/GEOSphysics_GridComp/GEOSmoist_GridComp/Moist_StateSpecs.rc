schema_version: 2.0.0
component: MOIST

# Driver imports and exports. The driver has no internals: each scheme
# registers its own internals and exports in its X_Setup, as in MAPL2.
#
# Not here: the MTR (bundle) and AERO (state) imports, hand-written
# MAPL_GridCompAddSpec calls in SetServices (ACG ITEMTYPE only does F/V).
#
# The PDF_* exports have COND: PDF_DIAG, a module constant that is
# .true. only when PDFDIAG is defined (MAPL2 registered them under
# #ifdef PDFDIAG; ACG cannot emit preprocessor conditions).
#
# From MAPL2: DEFAULT -> FILL; internals without DEFAULT get FILL 0.0 (MAPL2
# zero-filled internals, MAPL3 does not); MAPL_RestartSkip -> SKIP;
# AVERAGING_INTERVAL/REFRESH_INTERVAL and FRIENDLYTO dropped.

category: IMPORT
