#----------------------------------------------------------------------------------------------
# LIS_GridComp state specs (processed by mapl_acg, see CMakeLists.txt)
#
# Source: LISF NoahMP 5.0 GEOS field catalog (reference only, not compiled)
#   @LISF/lis/surfacemodels/land/noahmp.5.0/cpl_geos/reference/LIS_FieldCatalog_RAR.F90
#
# Rules for sorting catalog fields into states:
#   IMPORT   = adImport   and not directConn
#   EXPORT   = adExport   and not directConn
#   INTERNAL = directConn  (none in this catalog, so no INTERNAL category)
# NAME is the catalog stateName upper-cased; LONG NAME is the catalog stdName.
#
# Update of 2026-11-25 (field set replaced by the RAR catalog):
#   - 42 imports, 24 exports, 12 internals became 14 imports, 38 exports, 0 internals.
#   - INTERNAL category removed (SMLIQFRACL1-4, SMFRACL1-4, SOILTEMPL1-4).
#   - Units converted to MAPL style: kg/m2s -> kg m-2 s-1, W/m2 -> W m-2, m/s -> m s-1,
#     N/m2 -> N m-2, g/m2s -> g m-2 s-1, kg/kg -> kg kg-1, kg/m2 -> kg m-2,
#     m3/m3 -> m3 m-3, - -> 1, mm/soil_timestep -> kg m-2 (per LIS soil time step).
#   - SWD is kept as both an import and an export, as in the catalog.
#----------------------------------------------------------------------------------------------

schema_version: 2.0.0
component: LIS

category: IMPORT
#----------------------------------------------------------------------------------------------
#  VARIABLE        | DIMENSIONS        |          Additional Metadata
#----------------------------------------------------------------------------------------------
 NAME              | UNITS      | DIMS | VLOC | LONG NAME
#----------------------------------------------------------------------------------------------
 PSURF             | Pa         | xy   | N    | surface_air_pressure
 TAIR              | K          | xy   | N    | air_temperature
 QAIR              | kg kg-1    | xy   | N    | specific_humidity
 LWD               | W m-2      | xy   | N    | surface_downwelling_longwave_flux_in_air
 SWD               | W m-2      | xy   | N    | surface_downwelling_shortwave_flux_in_air
 U                 | m s-1      | xy   | N    | eastward_wind
 V                 | m s-1      | xy   | N    | northward_wind
 SNOWF_F           | kg m-2 s-1 | xy   | N    | snowfall_flux
 PRCP              | kg m-2 s-1 | xy   | N    | total_precipitation
 RAINFCONV_F       | kg m-2 s-1 | xy   | N    | convective_precipitation
 RAINFSHCONV_F     | kg m-2 s-1 | xy   | N    | shallow_convective_precipitation
 RAINFLS_F         | kg m-2 s-1 | xy   | N    | liquid_water_large_scale_precipitation
 GRAUPELF          | kg m-2 s-1 | xy   | N    | freezing_rain_fall
 HAILF             | kg m-2 s-1 | xy   | N    | icefall

category: EXPORT
#----------------------------------------------------------------------------------------------
#  VARIABLE        | DIMENSIONS        |          Additional Metadata
#----------------------------------------------------------------------------------------------
 NAME              | UNITS      | DIMS | VLOC | LONG NAME
#----------------------------------------------------------------------------------------------
 QS                | kg m-2     | xy   | N    | surface_runoff_amount
 QSB               | kg m-2     | xy   | N    | subsurface_runoff_amount
 TOTALRUNOFF       | kg m-2     | xy   | N    | total_runoff
 AVGSURFT          | K          | xy   | N    | surface_temperature
 AVGSURFQ          | kg kg-1    | xy   | N    | mean_surface_specific_humidity
 SNOW              | kg m-2     | xy   | N    | liquid_water_content_of_surface_snow
 TAIR_T2M          | K          | xy   | N    | 2m_air_temperature
 QH                | W m-2      | xy   | N    | surface_upward_sensible_heat_flux
 Z0                | m          | xy   | N    | surface_roughness_length
 CH_F              | m s-1      | xy   | N    | heat_exchange_coefficient_in_air
 CM_F              | m s-1      | xy   | N    | momentum_exchange_coefficient_in_air
 EVAP              | kg m-2 s-1 | xy   | N    | total_evapotranspiration
 ZPD               | m          | xy   | N    | displacement_height
 EMISS             | 1          | xy   | N    | emissivity
 ALBEDOVISDIR      | 1          | xy   | N    | surface_reflectivity_visible_beam
 ALBEDOVISDIF      | 1          | xy   | N    | surface_reflectivity_visible_diffuse
 ALBEDONIRDIR      | 1          | xy   | N    | surface_reflectivity_near_infrared_beam
 ALBEDONIRDIF      | 1          | xy   | N    | surface_reflectivity_near_infrared_diffuse
 USTARVEG          | m s-1      | xy   | N    | friction_velocity_vegetated
 USTARBARE         | m s-1      | xy   | N    | friction_velocity_bare
 USTAR             | m s-1      | xy   | N    | friction_velocity
 TAUX              | N m-2      | xy   | N    | eastward_surface_stress_on_air
 TAUY              | N m-2      | xy   | N    | northward_surface_stress_on_air
 SWD               | W m-2      | xy   | N    | surface_downwelling_shortwave_flux_in_air
 LAI               | 1          | xy   | N    | leaf_area_index
 SAI               | 1          | xy   | N    | stem_area_index
 VAI               | 1          | xy   | N    | vegetation_area_index
 GREENNESS         | 1          | xy   | N    | greenness_fraction
 LANDCOVER         | 1          | xy   | N    | vegetation_type
 QLE               | W m-2      | xy   | N    | latent_heat_flux
 CANOPINT          | kg m-2     | xy   | N    | canopy_water_content
 NEE               | g m-2 s-1  | xy   | N    | net_ecosystem_exchange
 STC1              | K          | xy   | N    | soil_temperature_layer_1
 SMC1              | m3 m-3     | xy   | N    | soil_moisture_layer_1
 ROOTMOIST         | m3 m-3     | xy   | N    | soil_moisture_rootzone
 SNOWH             | m          | xy   | N    | snow_depth
 SNOCVR            | 1          | xy   | N    | snow_cover_fraction
 RHOS              | 1          | xy   | N    | surface_air_density
